<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged by the Tauri CLI into the generated iOS Info.plist. Both are
       read from the built app: a hot reload does not pick a change up; the
       app has to be rebuilt and reinstalled.

       Trackpad and mouse on the iPad, as in Snorkle and Zotero Helper. In
       landscape with a Magic Keyboard, two-finger scrolls reached the web
       view turned a quarter round (a vertical swipe arrived as a horizontal
       one). Two settings, both needed:
       - UIApplicationSupportsIndirectInputEvents: UIKit hands the pointer's
         events on natively rather than as touch-compatibility events.
       - UIApplicationSceneManifest naming tao's scene delegate: without it
         tao starts on the legacy application-delegate path and the window
         is not created in its scene's orientation. One window only.
         (TaoSceneDelegate is tao's own class, 0.37 and later.) -->
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>Default Configuration</string>
          <key>UISceneDelegateClassName</key>
          <string>TaoSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <!-- The status bar is hidden by the app's view controller
       (prefersStatusBarHidden; src-tauri/src/ios.rs). This must stay YES
       (the default) for that to work: with NO, UIKit ignores the view
       controller, and apps built with the current SDK get no effect from
       UIApplication.statusBarHidden either. -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <true/>
  <!-- Opening a PDF from Files: the picker hands over a copy. -->
  <key>UISupportsDocumentBrowser</key>
  <false/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <false/>
</dict>
</plist>
