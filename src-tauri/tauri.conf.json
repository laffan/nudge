{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nudge",
  "version": "0.1.0",
  "identifier": "com.laffan.nudge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nudge",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "iOS": {
      "minimumSystemVersion": "18.0",
      "frameworks": ["Accelerate", "Foundation"]
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
